# --- Application ---
APP_ENV=development
APP_NAME=Public Grievance Management System

# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://pgms_user:pgms_password@localhost:5432/pgms_db

# --- Security / JWT ---
# Generate a strong random value before use, e.g. `openssl rand -hex 32`
SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File uploads (Step 3) ---
# Directory (relative to backend/) where grievance attachments are stored.
UPLOAD_DIR=uploads
MAX_ATTACHMENT_SIZE_MB=10

# Step 9 AI (optional)
AI_PROVIDER=fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_TIMEOUT_SECONDS=20
AI_CONFIDENCE_NORMAL=0.80
AI_CONFIDENCE_REVIEW=0.50
AI_RETENTION_DAYS=90
AI_MAX_PROMPT_CHARS=12000

# Step 12 Notifications (optional; core application works without external delivery)
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Public Grievance Management System
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
PUSH_NOTIFICATIONS_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
APP_PUBLIC_URL=http://localhost:5173

# Production hardening
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
DEBUG=false
